{
  "rules": {
    "meta": {
      "partiesHelped": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber()"
      }
    },
    "groups": {
      "$groupCode": {
        ".read": true,

        "filters": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['location','groupSize'])"
        },
        "createdAt": {
          ".write": "!data.exists()"
        },
        "restaurants": {
          ".write": "!data.exists() && root.child('groups/'+$groupCode+'/filters').exists()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChild('joinedAt') && newData.child('joinedAt').isNumber() && (!data.exists() || newData.child('joinedAt').val() == data.child('joinedAt').val()) && (newData.child('status').val() == 'waiting' || newData.child('status').val() == 'swiping')"
          }
        },
        "swipes": {
          "$uid": {
            "$rid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.isString() && (newData.val() == 'like' || newData.val() == 'dislike')"
            }
          }
        }
      }
    }
  }
}
